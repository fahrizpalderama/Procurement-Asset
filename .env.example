# --- OAUTH CONFIG (REQUIRED) ---
# Dapatkan dari Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxx"

# --- PERSISTENT STORAGE (RECOMMENDED FOR VERCEL) ---
# Jalankan sekali di AI Studio, dapatkan ID file Google Sheet yang terbentuk, 
# lalu tempel di sini agar aplikasi tidak membuat file baru setiap kali redeploy di Vercel.
MASTER_SPREADSHEET_ID=""
PHOTOS_FOLDER_ID="1AKVQmLWelx4GZDDBR6mAkqT6oyQ36QGO"

# --- APP CONFIG ---
# Email yang akan memiliki akses penuh sebagai Administrator
ADMIN_EMAIL="asset.sebelas11@gmail.com"

# APP_URL: Kosongkan saja agar aplikasi mendeteksi URL secara otomatis.
# Jika Anda mengisi ini, pastikan berisi URL Vercel tanpa tanda slash (/) di akhir.
APP_URL=""

# --- VERCEL DEPLOYMENT CHECKLIST ---
# 1. Tambahkan semua variabel di atas ke Vercel Project Settings > Environment Variables.
# 2. Tambahkan URL callback ke Authorized Redirect URIs di Google Cloud Console:
#    Format: https://domain-anda.vercel.app/auth/callback
